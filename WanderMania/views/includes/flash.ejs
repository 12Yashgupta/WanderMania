<% if(message && message.length){ %>
    <div class="alert alert-success alert-dismissible fade show col-4 offset-3 flash-msg" 
         style="position: fixed; top: 92px; height: 3.5rem; border: 1px solid black; z-index: 1 !important;" 
         role="alert">
      <%= message %> <span class="countdown">(3)</span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  
  <% if(error && error.length){ %>
    <div class="alert alert-danger alert-dismissible fade show col-4 offset-3 flash-msg" 
         style="position: fixed; top: 92px; height: 3.5rem; border: 1px solid black; z-index: 1 !important; font-weight: 700 !important;" 
         role="alert">
      <%= error %> <span class="countdown">(3)</span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  
  