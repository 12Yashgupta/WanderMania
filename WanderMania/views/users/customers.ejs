<%-layout("/layouts/boilerplate")%>

<style>
    .main{
        display: flex;
        flex-direction: column;
        padding: 1rem;
        width: 100%;
    }
    .main-customer{
        height: auto;
        width: 100%;
      margin-top: 2rem;
        padding: 2rem;

    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    border-bottom-left-radius: 1rem;
    border-bottom-right-radius: 1rem;}
   .customer{
   
    height: auto;
    display: flex;
    width: 80%;
    flex-direction: column;
    margin: auto;
    color: black;
    font-weight: 700;
   
    /* background-color: #e1f1f9; */
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    border-bottom-left-radius: 1rem;
    border-bottom-right-radius: 1rem;
    box-shadow: rgba(6, 24, 44, 0.4) 0px 0px 0px 2px, rgba(6, 24, 44, 0.65) 0px 4px 6px -1px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset;
   }
   .first{
    height: 3rem;
    width: 100%;
    display: flex;
   
   }
   .box1{
    width: 30%;
    /* box-shadow: rgba(0, 0, 0, 0.02) 0px 1px 3px 0px, rgba(27, 31, 35, 0.15) 0px 0px 0px 1px; */
    height: 100%;
    font-size: 1.2rem;
    text-align:  center;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: #0a5071 0px 0px 3px 0px;
   /* box-shadow: #0a5071 0px 2px 8px 0px; */
   }
   .box2{
    /* box-shadow: rgba(0, 0, 0, 0.02) 0px 1px 3px 0px, rgba(27, 31, 35, 0.15) 0px 0px 0px 1px; */
    width: 70%;
    height: 100%;
    font-size: 1.2rem;
    box-shadow: #0a5071 0px 0px 3px 0px;
    display: flex;
    align-items: center;
    margin-left: 1rem;
    
   }
   h4{
    font-size: 1.5rem;
    font-weight: 700;
    color: black;
    text-align: center;
   }
   h3{
    text-align: center;
    color:black;
    text-align: center;
    font-weight: 700;
    font-size: 3rem;
    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;
   }
   .nobook{
   height: auto;
   width: 50%;
   font-size: 3rem;
   color: #0a5071;
   margin: auto;
   text-align: center;
}

/* CSS */
.button-35 {
  align-items: center
  background-color: #fff
  border-radius: 12px
  box-shadow: transparent 0 0 0 3px,rgba(18, 18, 18, .1) 0 6px 20px
  box-sizing: border-box
  color: #121212
  cursor: pointer
  display: inline-flex
  flex: 1 1 auto
  font-family: Inter,sans-serif
  font-size: 1.2rem
  font-weight: 700
  justify-content: center
  line-height: 1
  margin: 0
  outline: none
  padding: 1rem 1.2rem
  text-align: center
  text-decoration: none
  transition: box-shadow .2s,-webkit-box-shadow .2s
  white-space: nowrap
  border: 0
  user-select: none
  -webkit-user-select: none
  touch-action: manipulation
}

.button-35:hover {
  box-shadow: #121212 0 0 0 3px, transparent 0 0 0 0
}
.button-delete {
     display: flex;
     margin-left: 8rem;
     margin-top: 1rem;
}


        .popup {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
}

.popup-content {
    background: white;
    padding: 20px;
    text-align: center;
    border-radius: 8px;
    box-shadow: 0px 0px 10px gray;
}
.delete-booking{
  display: flex;
 
}
    </style>
</style>
<body>
  
   <div class="main">
    <h3>Customer's <span style="color: #0a5071;">Booking</span></h3>
    <% if(owner.length>0) {%>
   <% for(own of owner){ %> 
    <hr>
    <div class="main-customer">
        <h4> <span style="color: #0a5071;">BOOKING-ID </span>: #<%=own._id%></h4>
        <div class="customer">
            <div class="first">
                <div class="box1">Place</div>
                <div class="box2"><%=own.place.title%></div>
           </div>
            <div class="first">
             <div class="box1">Username</div>
             <div class="box2"><%=own.owner.username%></div>
        </div>
        <div class="first">
         <div class="box1">Email</div>
         <div class="box2"><%=own.owner.email%></div>
    </div>
    <div class="first">
     <div class="box1">CheckIn</div>
     <div class="box2"><%=own.start%></div>
    </div>
    <div class="first">
    <div class="box1">CheckOut</div>
    <div class="box2"><%=own.end%></div>
    </div>
    <div class="first">
    <div class="box1">Total Guests</div>
    <div class="box2"><%=own.guest%></div>
    </div>
    <div class="first">
    <div class="box1">Total Days</div>
    <div class="box2"><%=own.days%></div>
    </div>
    <div class="first">
    <div class="box1">Total Fair</div>
    <div class="box2">&#8377;<%=((own.place.price*own.guest*own.days)+(own.place.price*own.guest*own.days*0.18)).toLocaleString("en-In")%></div>
    </div>
   
     </div> 
     <div class="button-delete">
          <!-- <form action="/profile/customers/<%=own._id%>" method="post" >
             <button class="button-35" >Delete Booking</button>
          </form> -->
          <button class="button-35" onclick="openPopup()">Deny customer Booking ?</button>
    </div>
     </div>
     <div>
      <div id="popup" class="popup">
        <div class="popup-content">
          <p>Are you sure to reject your customer's booking?</p>
          <!-- <form  action="/profile/customers/<%=own._id%>" method="post">
          <button onclick="deleteItem()">Yes</button>
        </form> -->
         <div class="delete-booking">
          <div style=" width: 1rem;  margin-left:7rem;">
          <form  action="/profile/customers/<%=own._id%>?_method=DELETE" method="post">
            <input type="hidden" name="itemId" value="123">
            <button type="submit">Yes</button>
        </form>
      </div>
      <div style=" width: 1rem; margin-left: 3rem;">
        <button onclick="closePopup()">No</button>
      </div>
         </div>
        
        <!-- <button onclick="deleteItem()">Yes</button>-->
       </div>
  </div>
    </div>
    
<% } %>
<% } %>
<% if(owner.length==0) {%>
    <div class="nobook">No Bookings</div>
<% } %>
   </div>
 
   <script>
   
   function openPopup() {
 document.getElementById("popup").style.display = "flex";
}

function closePopup() {
 document.getElementById("popup").style.display = "none";
}

function deleteItem() {
 
 closePopup();
}
     </script>
</body>