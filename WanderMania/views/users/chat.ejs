<%-layout("/layouts/boilerplate")%>

<style>
    .main{
        display: flex;
        flex-direction: column;
        padding: 1rem;
        width: 100%;
    }
    .main-customer{
        height: auto;
        width: 100%;
      margin-top: 2rem;
        padding: 2rem;

    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    border-bottom-left-radius: 1rem;
    border-bottom-right-radius: 1rem;}
   .customer{
   
    height: auto;
    display: flex;
    width: 80%;
    flex-direction: column;
    margin: auto;
    color: black;
    font-weight: 700;
   
    /* background-color: #e1f1f9; */
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    border-bottom-left-radius: 1rem;
    border-bottom-right-radius: 1rem;
    box-shadow: rgba(6, 24, 44, 0.4) 0px 0px 0px 2px, rgba(6, 24, 44, 0.65) 0px 4px 6px -1px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset;
   }
   .first{
    height: 3rem;
    width: 100%;
    display: flex;
   
   }
   .box1{
    width: 30%;
    /* box-shadow: rgba(0, 0, 0, 0.02) 0px 1px 3px 0px, rgba(27, 31, 35, 0.15) 0px 0px 0px 1px; */
    height: 100%;
    font-size: 1.2rem;
    text-align:  center;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: #0a5071 0px 0px 3px 0px;
   /* box-shadow: #0a5071 0px 2px 8px 0px; */
   }
   .box2{
    /* box-shadow: rgba(0, 0, 0, 0.02) 0px 1px 3px 0px, rgba(27, 31, 35, 0.15) 0px 0px 0px 1px; */
    width: 70%;
    height: 100%;
    font-size: 1.2rem;
    box-shadow: #0a5071 0px 0px 3px 0px;
    display: flex;
    align-items: center;
    margin-left: 1rem;
    
   }
   h4{
    font-size: 1.5rem;
    font-weight: 700;
    color: black;
    text-align: center;
   }
   h3{
    text-align: center;
    color:black;
    text-align: center;
    font-weight: 700;
    font-size: 3rem;
    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;
   }
   .nobook{
   height: auto;
   width: 50%;
   font-size: 3rem;
   color: #0a5071;
   margin: auto;
   text-align: center;
}

/* CSS */
.button-35 {
  align-items: center
  background-color: #fff
  border-radius: 12px
  box-shadow: transparent 0 0 0 3px,rgba(18, 18, 18, .1) 0 6px 20px
  box-sizing: border-box
  color: #121212
  cursor: pointer
  display: inline-flex
  flex: 1 1 auto
  font-family: Inter,sans-serif
  font-size: 1.2rem
  font-weight: 700
  justify-content: center
  line-height: 1
  margin: 0
  outline: none
  padding: 1rem 1.2rem
  text-align: center
  text-decoration: none
  transition: box-shadow .2s,-webkit-box-shadow .2s
  white-space: nowrap
  border: 0
  user-select: none
  -webkit-user-select: none
  touch-action: manipulation
}

.button-35:hover {
  box-shadow: #121212 0 0 0 3px, transparent 0 0 0 0
}
.button-delete {
     display: flex;
     margin-left: 8rem;
     margin-top: 1rem;
}


        .popup {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
}

.popup-content {
    background: white;
    padding: 20px;
    text-align: center;
    border-radius: 8px;
    box-shadow: 0px 0px 10px gray;
}
.delete-booking{
  display: flex;
 
}
.user-card {
    background-color: #ffffff;
    transition: background-color 0.2s;
    cursor: pointer;
  }

  .user-card:hover {
    background-color: #f1f1f1;
    border: 1px solid black;
  }
    </style>
</style>
<body>
  
   <div class="main">
    <h3>Customer's <span style="color: #0a5071;">Chats</span></h3>
    <% if(uniqueMatrix.length>0) {%>
        <% uniqueMatrix.forEach(user => { %>
         
        <a href="/chat/<%=user[1]%>/<%=currUser.username%>" style="text-decoration: none;">
            <div class="user-card d-flex align-items-center p-3 mb-3 rounded shadow-sm">
              <img src="https://gimgs2.nohat.cc/thumb/f/640/flat-person-icon-download-dummy-man--m2i8d3i8N4d3N4K9.jpg" 
                   alt="Cartoon Avatar" 
                   class="rounded-circle me-3" 
                   width="75" height="75">
              
              <span class="user-name fw-bold fs-5 text-dark"><%= user[0] %></span>
            </div>
        </a>
          <% }) %>
    <% } %>
<% if(uniqueMatrix.length==0) {%>
    <div class="nobook">No Chats</div>
<% } %>
   </div>
 

</body>