<%-layout("/layouts/boilerplate")%>

<style>

    </style>
</style>
<body>
    <div class="container py-5">
        <h2 class="mb-4 text-center fw-bold">My Wishlist</h2>
      
        <% if (wishlist.length === 0) { %>
          <div class="alert alert-info text-center">
            Your wishlist is empty. Start exploring and add your favorite places!
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-3 g-4">
            <% wishlist.forEach(listing => { %>
              <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                  <img src="<%= listing.image.url %>" class="card-img-top rounded-top-4" alt="Listing Image" style="height: 200px; object-fit: cover;">
                  <div class="card-body">
                    <h5 class="card-title mb-1 fw-semibold"><%= listing.title %></h5>
                    <p class="text-muted small mb-2"><%= listing.location %>, <%= listing.country %></p>
                    <p class="card-text mb-2" style="min-height: 60px;"><%= listing.description.substring(0, 90) %>...</p>
                    <span class="badge bg-secondary mb-2"><%= listing.category %></span>
                    <p class="fw-bold text-success mb-2">₹<%= listing.price %> / night</p>
      
                    <div class="d-flex justify-content-between">
                      <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">View</a>
                      <form action="/wishlist/<%= listing._id %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Remove</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

</body>