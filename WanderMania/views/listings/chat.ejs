<%-layout("/layouts/boilerplate")%>

  <style>
    body {
      font-family: sans-serif;
      margin: 0;
      padding: 0;
      background: #f4f4f4;
   
    }
    .chat-box {
      max-width: 1000px; /* Increased from 700px */
      margin: 30px auto;
      background: white;
      padding: 20px;
      border: 3px solid black;
      border-radius: 10px;
      height: 80vh;
      display: flex;
      flex-direction: column;
    }
    #messages {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 10px;
    }
    .message {
      padding: 10px;
      margin-bottom: 10px;
      border-radius: 8px;
      max-width: 70%;
    }
    .own {
      background: #0a5071;
      color: white;
      align-self: flex-end;
    }
    .other {
      background: #e1e1e1;
      color: black;
      align-self: flex-start;
    }
    form {
      display: flex;
    }
    input {
      flex: 1;
      padding: 10px;
      border-radius: 5px;
      border: 1px solid #ccc;
    }
    button {
      padding: 10px 20px;
      background: #0a5071;
      color: white;
      border: none;
      border-radius: 5px;
      margin-left: 10px;
    }
  </style>
  
<body>
  
  
  
    <div class="text-center ">
      <h1 class="display-6 fw-bold" style="color: #0a5071;">Have Chats</h1>
      <p class="lead text-muted ">Start a conversation and stay connected.</p>
    </div>
  
  <div class="chat-box">
    
    <div id="messages">
      <% messages.forEach(msg => { %>
        <div class="message <%= msg.sender === username ? 'own' : 'other' %>">
          <strong><%= msg.sender %>:</strong> <%= msg.message %>
        </div>
      <% }) %>
    </div>
    <form id="chatForm">
      <input id="msgInput" autocomplete="off" placeholder="Type a message..." />
      <button type="submit">Send</button>
    </form>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const roomId = "<%= roomId %>";
    const username = "<%= username %>";

    socket.emit("joinRoom", roomId);

    const form = document.getElementById("chatForm");
    const input = document.getElementById("msgInput");
    const messages = document.getElementById("messages");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = input.value;
      if (msg.trim()) {
        const data = { room: roomId, sender: username, message: msg };

        
        socket.emit("chat message", data);

       
        await fetch("/save-message", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...data, roomId })
        });

        input.value = "";
      }
    });

    socket.on("chat message", data => {
      const div = document.createElement("div");
      div.classList.add("message", data.sender === username ? "own" : "other");
      div.innerHTML = `<strong>${data.sender}:</strong> ${data.message}`;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    });
  </script>
</body>
